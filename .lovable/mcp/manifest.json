{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://xkmaovfxbrrmvebsmszt.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "nexora-ai-mcp",
      "version": "0.1.0",
      "title": "Nexora AI Studio"
    },
    "tools": [
      {
        "name": "solve_doubt",
        "title": "Solve a study doubt",
        "description": "Ask Nexora AI to solve a student's study question and return a deep, exam-ready explanation with steps, worked example, and quick recap.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "The student's question or doubt."
            }
          },
          "required": [
            "question"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "generate_mcqs",
        "title": "Generate MCQ quiz",
        "description": "Generate curriculum-aligned multiple-choice questions with detailed explanations and exam tips for a given subject, topic, and difficulty.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Subject, e.g. Biology, Physics, History."
            },
            "topic": {
              "type": "string",
              "maxLength": 200,
              "description": "Optional narrower topic."
            },
            "grade": {
              "type": "string",
              "maxLength": 40,
              "description": "Optional class/grade level."
            },
            "difficulty": {
              "type": "string",
              "enum": [
                "easy",
                "medium",
                "hard"
              ],
              "description": "Difficulty level."
            },
            "count": {
              "type": "integer",
              "minimum": 3,
              "maximum": 25,
              "description": "Number of questions (3-25)."
            }
          },
          "required": [
            "subject",
            "difficulty",
            "count"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "generate_study_material",
        "title": "Generate study material outline",
        "description": "Generate a deep, textbook-quality study outline (title, subject, summary, pages with headings, paragraphs, and bullets) for a topic in notes, presentation, or pdf format.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2000,
              "description": "Topic or study request."
            },
            "format": {
              "type": "string",
              "enum": [
                "notes",
                "presentation",
                "pdf"
              ],
              "description": "Desired study material format."
            }
          },
          "required": [
            "topic",
            "format"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
